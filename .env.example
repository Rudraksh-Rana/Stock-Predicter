# LSTM Stock Predictor Configuration
# Copy to .env and fill in your values

TICKER=AAPL
START_DATE=2018-01-01
END_DATE=2024-12-31
LOOKBACK=60

# Model hyperparameters
HIDDEN_SIZE_1=128
HIDDEN_SIZE_2=64
DROPOUT=0.2
BATCH_SIZE=32
EPOCHS=100
LR=0.001

# Paths
MODEL_PATH=models/lstm_model.pt
SCALER_PATH=models/scaler.pkl

# API
API_PORT=8000
API_HOST=0.0.0.0

# Streamlit
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
